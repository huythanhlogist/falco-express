# Giá trị AGENT_API_KEY lấy từ .env.local của dự án web falco-express
# (hoặc từ Environment variables trên Hostinger hPanel).
FALCO_AGENT_API_KEY=

# Để trống nếu dùng đúng web production. Đổi sang http://localhost:3000
# nếu bạn muốn test với `npm run dev` chạy local trước.
FALCO_ADMIN_BASE_URL=https://falcoexpress.com
