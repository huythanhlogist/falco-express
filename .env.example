# SMTP config for the contact form (src/app/api/contact/route.ts)
# Fill these in on the server (Hostinger hPanel > Advanced > Node.js > Environment variables)
# and never commit the real .env file.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@falcoexpress.com
SMTP_PASS=
CONTACT_TO_EMAIL=info@falcoexpress.com

# Google Sheet — mirror/export only (scripts/import-kango-orders.ts writes
# here after MySQL, so you can download an Excel copy). NOT read by the
# website anymore — see DB_* and KANGO_* below for the real data path.
GOOGLE_SERVICE_ACCOUNT_EMAIL=falco-tracking@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIExampleKeyContentHere\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Orders!A2:K1000

# Kango tracking API (src/lib/kango.ts) — the tracking page calls this
# live using the order's AWB, looked up from MySQL by Falco code.
KANGO_API_KEY=
KANGO_API_URL=https://kango-post.com/api/get-tracking

# Kango create-bill API (src/lib/kango-bill-api.ts) — used by /admin/kango-bills
# "Duyệt & Gửi Kango" to actually create a shipment. Same KANGO_API_KEY as
# above (confirmed to be one account-level key for both endpoints).
KANGO_CREATE_BILL_API_URL=https://kango-post.com/api/create-bill

# Lets an external agent (no admin login) create DRAFT Kango bills only, via
# POST /api/admin/kango-bills with header "x-agent-api-key: <this value>"
# (see src/proxy.ts + src/app/api/admin/kango-bills/route.ts). Never grants
# access to the real Kango-send endpoint. Generate the same way as the
# session secrets above.
AGENT_API_KEY=

# MySQL (src/lib/db.ts) — primary data store for orders/parcels. Create the
# database + user in Hostinger hPanel > Website > Databases.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Admin panel (src/lib/auth.ts, src/proxy.ts) — signs the admin login session
# cookie. Generate a random 32+ byte secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this value logs out every admin session.
ADMIN_SESSION_SECRET=

# CTV panel (src/lib/ctv-auth.ts, src/proxy.ts) — signs the CTV login session
# cookie. MUST be a different value from ADMIN_SESSION_SECRET (separate
# privilege domains, see ctv-auth.ts). Generate the same way as above.
# Changing this value logs out every CTV session.
CTV_SESSION_SECRET=
